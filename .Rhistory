View(FairFaceBlackWhite)
# function: calculate metrics
eval_binary <- function(df, truth_col, pred_col) {
truth <- sym(truth_col)
pred <- sym(pred_col)
y_true <- df %>% pull(!!truth)
y_pred <- df %>% pull(!!pred)
# Accuracy
acc <- mean(y_true == y_pred)
# Precision und Recall (Positiv = 1)
TP <- sum(y_true == 1 & y_pred == 1)
FP <- sum(y_true == 0 & y_pred == 1)
FN <- sum(y_true == 1 & y_pred == 0)
precision <- ifelse((TP + FP) == 0, NA, TP / (TP + FP))
recall    <- ifelse((TP + FN) == 0, NA, TP / (TP + FN))
return(tibble(
Metric = c("Accuracy", "Precision", "Recall"),
Value = c(acc, prec, rec)
))
}
BlackWhiteResults = eval_binary(FairFaceBlackWhite,"Truth","Prediction")
