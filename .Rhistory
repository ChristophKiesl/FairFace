# function: calculate metrics for Multi-class problem
eval_multiclass <- function(df, truth_col, pred_col, prob_cols) {
truth <- sym(truth_col)
pred <- sym(pred_col)
y_true <- df %>% pull(!!truth)
y_pred <- df %>% pull(!!pred)
probs  <- df %>% select(all_of(prob_cols))
# Accuracy
acc <- mean(y_true == y_pred)
# map to index if truth is a factor
if (is.factor(y_true)) {
class_levels <- levels(y_true)
y_idx <- as.integer(y_true)
} else {
class_levels <- sort(unique(y_true))
y_idx <- match(y_true, class_levels)
}
# extract probability of true class
true_probs <- probs %>%
as.matrix() %>%
`[cbind(1:nrow(probs), y_idx)]`
# Log-Loss
eps <- 1e-15
logloss <- -mean(log(pmax(pmin(true_probs, 1 - eps), eps)))
return(tibble(
Metric = c("Accuracy", "LogLoss"),
Value  = c(acc, logloss)
))
}
