log_deaths_imputed ~ i(rel_year, treated.Ahal, ref = 0) | Region + Year,
data = event_data,
cluster = ~ Year + Region
)
summary(event_study_log_ols)
iplot(event_study_log_ols)
event_study_log_ols <- feols(
log_deaths_imputed ~ i(rel_year, treat.Ahal, ref = 0) | Region + Year,
data = event_data,
cluster = ~ Year + Region
)
summary(event_study_log_ols)
coef_table <- broom::tidy(event_study_log_ols) %>%
filter(grepl("rel_year::", term)) %>%
mutate(
rel_year = as.numeric(gsub("rel_year::", "", term)),
lower = estimate - 1.96 * std.error,
upper = estimate + 1.96 * std.error
)
ggplot(coef_table, aes(x = rel_year, y = estimate)) +
geom_point() +
geom_errorbar(aes(ymin = lower, ymax = upper), width = 0.2) +
geom_hline(yintercept = 0, linetype = "dashed") +
labs(x = "Relative year", y = "Effect (log deaths)") +
theme_minimal()
coef_table <- broom::tidy(event_study_log_ols) %>%
filter(grepl("rel_year::", term)) %>%
mutate(
rel_year = as.numeric(sub("rel_year::", "", term)),
lower = estimate - 1.96 * std.error,
upper = estimate + 1.96 * std.error
) %>%
filter(!is.na(rel_year))
coef_table
event_study_log_ols
# 1) Rohdaten aus Modell holen
coefs <- coef(event_study_log_ols)               # named vector
vc <- try(vcov(event_study_log_ols), silent = TRUE)
if(inherits(vc, "try-error")) stop("vcov() failed on model — check model object.")
# 2) Standardfehler (nur für die vorhandenen Coefs)
se_all <- sqrt(diag(vc))[names(coefs)]
coef_df <- tibble(
term = names(coefs),
estimate = as.numeric(coefs),
std.error = as.numeric(se_all)
)
# 3) Flexible Extraktion der relativen Jahre
# Unterstützt:
# - "rel_year::-1:treat.Ahal"  -> extrahiert -1
# - "Year::2018:treat.Ahal"    -> wandelt zu rel = 2018 - ref_year (default ref = 2017)
ref_year <- 2017  # falls du anderen Referenzjahr brauchst, anpassen
coef_df <- coef_df %>%
# drop Terms ohne SE (falls vorhanden)
filter(!is.na(std.error)) %>%
mutate(
rel_year = case_when(
grepl("rel_year::", term) ~ as.numeric(sub(".*rel_year::(-?\\d+).*", "\\1", term)),
grepl("^Year::", term) ~ as.numeric(sub(".*Year::(\\d+).*", "\\1", term)) - ref_year,
TRUE ~ NA_real_
)
) %>%
filter(!is.na(rel_year)) %>%        # nur die ES-relevanten Zeilen behalten
arrange(rel_year) %>%
mutate(
lower = estimate - 1.96 * std.error,
upper = estimate + 1.96 * std.error
)
# quick check: falls leer, Ausgabe mit Hilfestellung
if(nrow(coef_df) == 0){
message("Die extrahierte Tabelle ist leer. Zeige die Namen aller Koeffizienten im Modell zur Diagnose:")
print(names(coefs))
stop("Keine Event-Study-Koeffizienten gefunden — prüfe die Term-Namen oben.")
}
# 4) Plot bauen
plt <- ggplot(coef_df, aes(x = rel_year, y = estimate)) +
geom_hline(yintercept = 0, linetype = "dashed", color = "grey40") +
geom_ribbon(aes(ymin = lower, ymax = upper, group = 1), alpha = 0.2) +
geom_line(aes(group = 1)) +
geom_point(size = 3) +
geom_errorbar(aes(ymin = lower, ymax = upper), width = 0.1) +
scale_x_continuous(breaks = coef_df$rel_year) +
labs(x = "Relative year (ref = 0)", y = "Estimate (log deaths)",
title = "Event-Study coefficients", subtitle = paste0("Reference year = ", ref_year)) +
theme_minimal()
print(plt)
# 5) Zur weiteren Kontrolle die Tabelle ausgeben
print(coef_df)
