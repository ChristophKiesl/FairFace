classified <- final_dataset %>% select(player_id_sofascore,skin_color_dim3) %>% unique()
View(classified)
to_classify <- players %>%
filter(!ID %in% classified$player_id_sofascore)
View(to_classify)
setwd("C:/Users/Luca Cermak/Nextcloud/Documents/Dissertation/Projekt 2 - Rassismus/Bilder_2425")
setwd("C:/Users/Luca Cermak/Nextcloud/Documents/Dissertation/Projekt 2 - Rassismus/Bilder_2425")
for(i in 1:length(to_classify$ID)){
image_link <- paste("https://api.sofascore.app/api/v1/player/",to_classify$ID[i],"/image",sep = "")
destfile <- paste0(to_classify$ID[i], ".jpg")
res <- GET(image_link, add_headers("User-Agent" = "Mozilla/5.0"))
if (status_code(res) == 200) {
writeBin(content(res, "raw"), destfile)
} else {
warning(paste("Fehler beim Download für Spieler", to_classify$ID[i], "Status:", status_code(res)))
}
cat("Lade Bild für Spieler:", to_classify$ID[i], "/ i = ",i,"\n")
Sys.sleep(sample(1:3,1))
}
warnings()
img_dir <- "C:/Users/Luca Cermak/Nextcloud/Documents/Dissertation/Projekt 2 - Rassismus/Bilder_2425"
img_files <- dir_ls(img_dir, regexp = "\\.(jpg|jpeg|png|webp)$", recurse = FALSE)
img_info <- file_info(img_files)
files_df <- tibble(
path  = img_files,
file  = path_file(img_files),
size  = img_info$size,
id    = str_remove(file, "\\.[^.]+$")   # Endung abschneiden → reine ID
)
bad_ids <- files_df %>%
filter(size == 0) %>%
pull(id)
missing_ids <- setdiff(to_classify$ID, files_df$id)
all_missing_ids <- union(bad_ids, missing_ids)
all_missing_ids <- unique(all_missing_ids)
missing_imgs <- to_classify %>%
filter(ID %in% all_missing_ids)
print(missing_imgs)
cat("Insgesamt fehlen/defekt:", nrow(missing_imgs), "Bilder\n")
missing_imgs$url <- ""
writexl::write_xlsx(missing_imgs, "missing_players_images_2425.xlsx")
writexl::write_xlsx(missing_imgs, "missing_players_images_2425.xlsx")
